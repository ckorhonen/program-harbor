{
  "name": "program-harbor",
  "version": "0.1.0",
  "private": true,
  "description": "A calm, open-source program operations desk for conference teams.",
  "scripts": {
    "dev": "PROGRAM_HARBOR_DEMO_MODE=true next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:dom": "tsx scripts/audit-dom.ts",
    "measure:local": "tsx scripts/measure-local.ts",
    "seed": "PROGRAM_HARBOR_DEMO_MODE=true tsx scripts/seed.ts",
    "reset-demo": "PROGRAM_HARBOR_DEMO_MODE=true tsx scripts/reset-demo.ts"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "ics": "^3.8.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanitize-html": "^2.17.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/sanitize-html": "^2.16.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
